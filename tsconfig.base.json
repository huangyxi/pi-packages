{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"noUncheckedSideEffectImports": true,
		"erasableSyntaxOnly": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"paths": {
			"@/*": ["./*"]
		}
	}
}
