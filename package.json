{
	"name": "pi-packages",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm -r --if-present run build",
		"check": "run-s lint typecheck test",
		"lint": "run-p lint:*",
		"lint:eslint": "eslint . --ignore-pattern 'packages/**'",
		"lint:prettier": "prettier --check .",
		"lint:packages": "pnpm -r --if-present run lint",
		"typecheck": "run-p typecheck:*",
		"typecheck:root": "tsc --noEmit",
		"typecheck:packages": "pnpm -r --if-present run typecheck",
		"test": "run-p test:*",
		"test:root": "vitest run --dir test",
		"test:packages": "pnpm -r --if-present run test",
		"format": "run-s format:*",
		"format:eslint": "eslint . --fix --ignore-pattern 'packages/**'",
		"format:prettier": "prettier --write --list-different .",
		"format:packages": "pnpm -r --if-present run format"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@types/node": "^24.13.3",
		"eslint": "^10.8.0",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"npm-run-all2": "^9.0.2",
		"prettier": "^3.9.6",
		"prettier-plugin-multiline-arrays": "^4.1.11",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1",
		"vite": "^8.2.0",
		"vite-plugin-banner": "^0.8.1",
		"vitest": "^4.1.10"
	}
}
