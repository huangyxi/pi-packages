{
	"name": "@hyxi/pi-envguard",
	"version": "0.1.1",
	"description": "Environment filtering and tool-result redaction for Pi",
	"license": "MIT",
	"homepage": "https://github.com/huangyxi/pi-packages/tree/main/packages/pi-envguard",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/huangyxi/pi-packages.git",
		"directory": "packages/pi-envguard"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"security",
		"redaction",
		"environment"
	],
	"type": "module",
	"pi": {
		"extensions": [
			"./dist/extension.js"
		]
	},
	"main": "./dist/extension.js",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "vite build",
		"check": "run-s lint typecheck test",
		"lint": "run-p --continue-on-error lint:*",
		"lint:eslint": "eslint .",
		"lint:prettier": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"format": "run-s format:*",
		"format:eslint": "eslint . --fix",
		"format:prettier": "prettier --write --list-different .",
		"smoke": "node --input-type=module --eval \"const extension = await import('./dist/extension.js'); if (typeof extension.default !== 'function') process.exit(1)\""
	}
}
