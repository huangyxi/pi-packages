{
	"name": "pi-packages",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r --if-present run build",
		"check": "run-p --continue-on-error check:*",
		"check:root": "run-s lint:root typecheck:root test:root",
		"check:packages": "pnpm -r --if-present run check",
		"lint": "run-p --continue-on-error lint:*",
		"lint:root": "run-p --continue-on-error lint:root:*",
		"lint:root:eslint": "eslint . --ignore-pattern 'packages/**'",
		"lint:root:prettier": "prettier --check .",
		"lint:packages": "pnpm -r --if-present run lint",
		"typecheck": "run-p --continue-on-error typecheck:*",
		"typecheck:root": "tsc --noEmit",
		"typecheck:packages": "pnpm -r --if-present run typecheck",
		"test": "run-p --continue-on-error test:*",
		"test:root": "vitest run --dir test",
		"test:packages": "pnpm -r --if-present run test",
		"format": "run-s format:*",
		"format:eslint": "eslint . --fix --ignore-pattern 'packages/**'",
		"format:prettier": "prettier --write --list-different .",
		"format:packages": "pnpm -r --if-present run format",
		"publish:package": "node scripts/publish.ts"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@types/node": "^26.1.2",
		"eslint": "^10.8.0",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"npm-run-all2": "^9.0.3",
		"prettier": "^3.9.6",
		"prettier-plugin-multiline-arrays": "^4.1.11",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.0",
		"vite-plugin-banner": "^0.8.1",
		"vitest": "^4.1.10"
	}
}
